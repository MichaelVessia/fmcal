{
  "name": "fmcal",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "cli": "bun run src/main.ts",
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile fmcal",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "effect": "^3.12",
    "@effect/cli": "^0.54",
    "@effect/platform": "^0.72",
    "@effect/platform-bun": "^0.52",
    "tsdav": "^2.1",
    "ical.js": "^2.1"
  },
  "devDependencies": {
    "@codeforbreakfast/bun-test-effect": "^0.4.1",
    "@effect/language-service": "^0.62",
    "@types/bun": "^1.3.5",
    "oxfmt": "^0.20.0",
    "oxlint": "^0.16.0",
    "typescript": "^5.7"
  }
}
